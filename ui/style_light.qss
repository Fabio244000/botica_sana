/* Paleta básica light */
QWidget {
    background-color: #f5f5f5;
    color: #111;
    font-size: 10pt;
}

/* Inputs */
QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
    background-color: white;
    color: #111;
    border: 1px solid #ccc;
    padding: 6px;
    border-radius: 4px;
}

/* Botones */
QPushButton {
    background-color: #e0e0e0;
    color: #111;
    border-radius: 6px;
    padding: 6px 12px;
}
QPushButton:hover {
    background-color: #d0d0d0;
}
QPushButton:pressed {
    background-color: #b0bec5;
}

/* Botón destacado (cerrar sesión) */
QPushButton#btn_logout {
    background-color: #e53935;
    color: white;
}

/* Botón alerta */
QPushButton#btn_alert {
    background-color: transparent;
    border: none;
    color: red;
    font-size: 14px;
}

/* Botón activo en el menú lateral */
QVBoxLayout QPushButton:checked {
    background-color: #c5cae9;
    font-weight: bold;
    border: 1px solid #3f51b5;
}

/* Tablas */
QTableView {
    background-color: white;
    color: #111;
    border: 1px solid #ccc;
}
QHeaderView::section {
    background-color: #eeeeee;
    padding: 4px;
    border: 1px solid #ccc;
}
